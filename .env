# Salin file ini menjadi ".env", lalu masukkan API key Gemini milikmu.
# Jangan bagikan file .env atau unggah ke GitHub.
GEMINI_API_KEY="AQ.Ab8RN6L7Uv5XO2SIUbCA0I_Xf-Y4coxBnUaYMNaqww6JbGKMxA"

# Model utama + cadangan jika model utama tidak tersedia.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# 1 = paksa mode demo. 0 = gunakan Gemini jika API key sudah diisi.
DEMO_MODE=0
PORT=3000

# Gambar hasil akhir: bawaannya ilustrasi SVG yang digambar model teks (GRATIS), tidak perlu diisi.
# Isi hanya jika billing aktif dan mau gambar AI asli (berbayar), mis. gemini-3.1-flash-lite-image.
# Kalau model ini gagal (kuota/billing), server otomatis kembali ke ilustrasi SVG.
GEMINI_IMAGE_MODEL=
